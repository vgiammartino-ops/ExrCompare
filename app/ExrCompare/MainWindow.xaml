<?xml version="1.0" encoding="utf-8"?>
<!--
    EXR Compare main window. Layout, top to bottom:
      title bar | menu bar | viewer toolbar (compare mode, colour) | viewer + side pane | timeline | transport
    Stock WinUI 3 controls and Segoe Fluent Icons throughout. The only drawn elements are the viewer
    overlays (wipe handles, data-window outlines, Pixel Analyzer box, contact-sheet labels).
-->
<Window
    x:Class="ExrCompare.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExrCompare.Controls"
    Title="EXR Compare">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Padding="12,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8B9;" FontSize="14" />
                <TextBlock x:Name="TitleText" Text="EXR Compare" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Menu -->
        <MenuBar Grid.Row="1">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open into A..." KeyboardAcceleratorTextOverride="Ctrl+O" Click="OnOpenA">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open into B..." KeyboardAcceleratorTextOverride="Ctrl+Shift+O" Click="OnOpenB" />
                <MenuFlyoutItem Text="Open folder into A..." Click="OnOpenFolderA">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Folder" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open folder into B..." Click="OnOpenFolderB" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Open session..." Click="OnOpenSession" />
                <MenuFlyoutItem Text="Save session..." KeyboardAcceleratorTextOverride="Ctrl+S" Click="OnSaveSession">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Save" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Export snapshot..." KeyboardAcceleratorTextOverride="Ctrl+E" Click="OnSnapshot">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Camera" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Export notes (CSV)..." Click="OnExportNotes" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="OnExit" />
            </MenuBarItem>
            <MenuBarItem Title="Playback">
                <MenuFlyoutItem Text="Play / pause" KeyboardAcceleratorTextOverride="Space" Click="OnPlayPause" />
                <MenuFlyoutItem Text="Play backward" KeyboardAcceleratorTextOverride="Ctrl+Space" Click="OnPlayReverse" />
                <MenuFlyoutItem Text="Step forward" KeyboardAcceleratorTextOverride="Right" Click="OnStepForward" />
                <MenuFlyoutItem Text="Step backward" KeyboardAcceleratorTextOverride="Left" Click="OnStepBackward" />
                <MenuFlyoutItem Text="Go to start" KeyboardAcceleratorTextOverride="Home" Click="OnGoToStart" />
                <MenuFlyoutItem Text="Go to end" KeyboardAcceleratorTextOverride="End" Click="OnGoToEnd" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="LoopMenuItem" Text="Loop" IsChecked="True" Click="OnLoopMenu" />
                <ToggleMenuFlyoutItem x:Name="PlayAllMenuItem" Text="Play all frames (no skipping)" Click="OnPlayAllFrames" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Set in point" KeyboardAcceleratorTextOverride="I" Click="OnSetIn" />
                <MenuFlyoutItem Text="Set out point" KeyboardAcceleratorTextOverride="O" Click="OnSetOut" />
                <MenuFlyoutItem Text="Clear in / out" KeyboardAcceleratorTextOverride="Shift+I" Click="OnClearInOut" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Cache">
                    <RadioMenuFlyoutItem Text="Off" GroupName="Cache" Tag="off" Click="OnCacheMode" />
                    <RadioMenuFlyoutItem Text="Look-ahead" GroupName="Cache" Tag="lookahead" IsChecked="True" Click="OnCacheMode" />
                    <RadioMenuFlyoutItem Text="Region (in to out)" GroupName="Cache" Tag="region" Click="OnCacheMode" />
                    <MenuFlyoutSeparator />
                    <RadioMenuFlyoutItem Text="25% of RAM" GroupName="CacheSize" Tag="25" Click="OnCacheSize" />
                    <RadioMenuFlyoutItem Text="50% of RAM" GroupName="CacheSize" Tag="50" IsChecked="True" Click="OnCacheSize" />
                    <RadioMenuFlyoutItem Text="75% of RAM" GroupName="CacheSize" Tag="75" Click="OnCacheSize" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="ProxyMenuItem" Text="Half-resolution proxy" Click="OnProxyMenu" />
            </MenuBarItem>
            <MenuBarItem Title="Compare">
                <MenuFlyoutItem Text="Toggle wipe" KeyboardAcceleratorTextOverride="W" Click="OnToggleWipe" />
                <MenuFlyoutItem Text="Swap A / B" KeyboardAcceleratorTextOverride="Enter" Click="OnSwap" />
                <MenuFlyoutItem Text="Reset wipe" Click="OnResetWipe" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="LockAovMenuItem" Text="Lock AOV across layers" IsChecked="True" Click="OnLockAovMenu" />
                <MenuFlyoutSubItem Text="Align B to A">
                    <RadioMenuFlyoutItem Text="Fit to A's size" GroupName="Align" Tag="fit" IsChecked="True" Click="OnAlign" />
                    <RadioMenuFlyoutItem Text="Same pixel scale" GroupName="Align" Tag="pixel" Click="OnAlign" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Previous version of A" KeyboardAcceleratorTextOverride="Alt+Down" Click="OnVersionDownA" />
                <MenuFlyoutItem Text="Next version of A" KeyboardAcceleratorTextOverride="Alt+Up" Click="OnVersionUpA" />
                <MenuFlyoutItem Text="Previous version of B" KeyboardAcceleratorTextOverride="Alt+Shift+Down" Click="OnVersionDownB" />
                <MenuFlyoutItem Text="Next version of B" KeyboardAcceleratorTextOverride="Alt+Shift+Up" Click="OnVersionUpB" />
            </MenuBarItem>
            <MenuBarItem Title="Colour">
                <MenuFlyoutItem Text="Load OCIO config..." Click="OnLoadOcio" />
                <MenuFlyoutSubItem x:Name="BuiltinConfigsMenu" Text="Built-in configs" />
                <MenuFlyoutItem Text="Use $OCIO / default config" Click="OnDefaultOcio" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Reset exposure and gamma" KeyboardAcceleratorTextOverride="0" Click="OnResetExposure" />
                <ToggleMenuFlyoutItem x:Name="FalseColorMenuItem" Text="False colour (exposure)" Click="OnColorFlagsMenu" />
                <ToggleMenuFlyoutItem x:Name="NanMenuItem" Text="Highlight NaN / Inf / negative" Click="OnColorFlagsMenu" />
                <ToggleMenuFlyoutItem x:Name="MatteMenuItem" Text="Alpha matte overlay" KeyboardAcceleratorTextOverride="M" Click="OnColorFlagsMenu" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Fit" KeyboardAcceleratorTextOverride="F" Click="OnFit" />
                <MenuFlyoutItem Text="Actual size (1:1)" KeyboardAcceleratorTextOverride="1" Click="OnOneToOne" />
                <MenuFlyoutItem Text="Full screen" KeyboardAcceleratorTextOverride="F11" Click="OnFullScreen">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="FullScreen" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="OverlaysMenuItem" Text="Overlays (wipe handles, outlines, sample box)" IsChecked="True"
                                      KeyboardAcceleratorTextOverride="Q" Click="OnOverlaysMenu" />
                <ToggleMenuFlyoutItem x:Name="HudMenuItem" Text="Image info (HUD)" IsChecked="True" Click="OnHudMenu" />
                <ToggleMenuFlyoutItem x:Name="DataWindowMenuItem" Text="Data window outline" IsChecked="True" Click="OnOverlaysMenu" />
                <ToggleMenuFlyoutItem x:Name="SidePaneMenuItem" Text="Side pane" IsChecked="False" Click="OnSidePaneMenu" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Contact sheet (layer A)" KeyboardAcceleratorTextOverride="T" Click="OnContactSheetA" />
            </MenuBarItem>
            <MenuBarItem Title="Tools">
                <MenuFlyoutItem Text="Pixel Analyzer" Click="OnShowPixelPane" />
                <MenuFlyoutItem Text="Clear pixel sample" KeyboardAcceleratorTextOverride="Esc" Click="OnClearSample" />
                <MenuFlyoutItem Text="Sample a box: Ctrl+drag on the image" IsEnabled="False" />
                <MenuFlyoutItem Text="Pin one pixel: Ctrl+click" IsEnabled="False" />
                <MenuFlyoutItem Text="Isolate Cryptomatte ID: Alt+click" IsEnabled="False" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Keyboard shortcuts" Click="OnShortcuts">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="About EXR Compare" Click="OnAbout" />
            </MenuBarItem>
        </MenuBar>

        <!-- Viewer toolbar (Nuke-style: compare + colour controls above the image) -->
        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                      Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,4">
                <!-- Nuke viewer input bar: [A  aov v] [compare on/off  mode v] [B  aov v] -->
                <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="4"
                        Padding="3,2" VerticalAlignment="Center" Background="{ThemeResource ControlFillColorTransparentBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="ShowAButton" Content="A" Style="{StaticResource InputLetterStyle}" Click="OnShowA"
                                ToolTipService.ToolTip="Show A only" />
                        <controls:WheelComboBox x:Name="ToolbarAovCombo" Width="190" VerticalAlignment="Center" IsEnabled="False"
                                                SelectionChanged="OnToolbarAovChanged"
                                                ToolTipService.ToolTip="AOV of A. Mouse wheel steps one AOV; B follows while Lock AOV is on." />
                        <ToggleButton x:Name="CompareToggle" Style="{StaticResource IconToggleStyle}" Click="OnCompareToggle"
                                      ToolTipService.ToolTip="Compare on / off (off shows A)">
                            <FontIcon Glyph="&#xEC11;" FontSize="16" />
                        </ToggleButton>
                        <controls:WheelComboBox x:Name="CompareCombo" Width="128" VerticalAlignment="Center" SelectedIndex="0"
                                                SelectionChanged="OnCompareComboChanged" ToolTipService.ToolTip="Compare mode (W wipe, S stack, D difference)">
                            <ComboBoxItem Content="wipe" Tag="wipe" />
                            <ComboBoxItem Content="stack" Tag="stack" />
                            <ComboBoxItem Content="difference" Tag="difference" />
                            <ComboBoxItem Content="side by side" Tag="sidebyside" />
                            <ComboBoxItem Content="over / under" Tag="overunder" />
                        </controls:WheelComboBox>
                        <Button x:Name="ShowBButton" Content="B" Style="{StaticResource InputLetterStyle}" Click="OnShowB"
                                ToolTipService.ToolTip="Show B only" />
                        <controls:WheelComboBox x:Name="ToolbarAovComboB" Width="190" VerticalAlignment="Center" IsEnabled="False"
                                                SelectionChanged="OnToolbarAovChangedB"
                                                ToolTipService.ToolTip="AOV of B. Mouse wheel steps one AOV." />
                    </StackPanel>
                </Border>
                <Button Click="OnSwap" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Swap A and B (Enter)">
                    <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                </Button>
                <!-- Fixed-width slot so the toolbar never shifts when these appear. -->
                <Grid Width="112" VerticalAlignment="Center">
                    <NumberBox x:Name="DiffGainBox" PlaceholderText="Gain" Value="1" Minimum="0.01" SmallChange="1"
                               SpinButtonPlacementMode="Compact" Visibility="Collapsed"
                               ToolTipService.ToolTip="Difference gain" ValueChanged="OnDiffGainChanged" />
                    <NumberBox x:Name="WipeSoftBox" PlaceholderText="Softness" Value="0" Minimum="0" SmallChange="2"
                               SpinButtonPlacementMode="Compact" Visibility="Collapsed"
                               ToolTipService.ToolTip="Wipe edge softness (pixels)" ValueChanged="OnWipeSoftChanged" />
                </Grid>
                <Border Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ComboBox x:Name="ChannelCombo" Width="132" SelectedIndex="0" VerticalAlignment="Center"
                          SelectionChanged="OnChannelChanged" ToolTipService.ToolTip="Channel (C R G B A Y)">
                    <x:String>RGB</x:String>
                    <x:String>Red</x:String>
                    <x:String>Green</x:String>
                    <x:String>Blue</x:String>
                    <x:String>Alpha</x:String>
                    <x:String>Luminance</x:String>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Exposure in stops (double-click the value to reset)">
                    <FontIcon Glyph="&#xE706;" FontSize="16" />
                    <Slider x:Name="ExposureSlider" Width="130" Minimum="-10" Maximum="10" StepFrequency="0.1"
                            VerticalAlignment="Center" ValueChanged="OnExposureChanged" />
                    <TextBlock x:Name="ExposureText" Text="+0.0" Width="34" VerticalAlignment="Center"
                               DoubleTapped="OnResetExposureTapped" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTipService.ToolTip="Gamma">
                    <TextBlock Text="&#x03B3;" VerticalAlignment="Center" FontSize="16" />
                    <Slider x:Name="GammaSlider" Width="100" Minimum="0.2" Maximum="4" StepFrequency="0.05" Value="1"
                            VerticalAlignment="Center" ValueChanged="OnGammaChanged" />
                    <TextBlock x:Name="GammaText" Text="1.00" Width="34" VerticalAlignment="Center"
                               DoubleTapped="OnResetExposureTapped" />
                </StackPanel>
                <Border Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ComboBox x:Name="DisplayCombo" Width="180" VerticalAlignment="Center" SelectionChanged="OnDisplayChanged"
                          ToolTipService.ToolTip="OCIO display" />
                <ComboBox x:Name="ViewCombo" Width="320" VerticalAlignment="Center" SelectionChanged="OnViewChanged"
                          ToolTipService.ToolTip="OCIO view" />
                <ComboBox x:Name="LookCombo" Width="140" VerticalAlignment="Center" SelectionChanged="OnLookChanged"
                          ToolTipService.ToolTip="OCIO look" Visibility="Collapsed" />
                <Border Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ToggleButton x:Name="FalseColorToggle" Style="{StaticResource IconToggleStyle}" Click="OnColorFlagsToggle" VerticalAlignment="Center"
                              ToolTipService.ToolTip="False colour: exposure heat map (+-6 stops around 18% grey)">
                    <FontIcon Glyph="&#xE790;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="NanToggle" Style="{StaticResource IconToggleStyle}" Click="OnColorFlagsToggle" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Highlight NaN / Inf (magenta) and negative values (cyan)">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="MatteToggle" Style="{StaticResource IconToggleStyle}" Click="OnColorFlagsToggle" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Alpha matte overlay (M)">
                    <FontIcon Glyph="&#xE7A8;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="ProxyToggle" Style="{StaticResource IconToggleStyle}" Click="OnProxyToggle" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Half-resolution proxy (uses mip level 1 when the EXR has one)">
                    <FontIcon Glyph="&#xE71F;" FontSize="16" />
                </ToggleButton>
            </StackPanel>
        </ScrollViewer>

        <!-- Viewer + side pane -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="ViewerArea" Background="Black" IsTabStop="True"
                  PointerPressed="OnViewerPointerPressed" PointerMoved="OnViewerPointerMoved"
                  PointerReleased="OnViewerPointerReleased" PointerExited="OnViewerPointerExited"
                  PointerWheelChanged="OnViewerWheel" DoubleTapped="OnViewerDoubleTapped"
                  SizeChanged="OnViewerSizeChanged">
                <SwapChainPanel x:Name="Viewer" Loaded="OnViewerLoaded" CompositionScaleChanged="OnViewerScaleChanged" />
                <Canvas x:Name="Overlay" IsHitTestVisible="False" />

                <Border x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,12"
                        CornerRadius="16" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Drop EXR sequences here" Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="First drop goes to A, the next to B. Ctrl+O opens A, Ctrl+Shift+O opens B."
                                   Opacity="0.75" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="MissingText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <Border x:Name="HudPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4"
                        CornerRadius="4" Background="{ThemeResource SmokeFillColorDefaultBrush}" Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="HudText" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </Border>
                <ProgressRing x:Name="LoadingRing" Width="20" Height="20" Margin="10" HorizontalAlignment="Right"
                              VerticalAlignment="Top" IsActive="False" />
                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" Title="Problem" VerticalAlignment="Top" Margin="48,8" />
            </Grid>

            <!-- Pixel readout (Nuke viewer info bar): position, sample size, R G B A, display swatch. -->
            <Border x:Name="ReadoutBar" Grid.Row="1" Background="Black" Padding="8,3" Height="62"
                    BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    ToolTipService.ToolTip="Hover to read pixels. Ctrl+drag: sample a box. Ctrl+click: pin a pixel. Esc: clear.">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Always two fixed rows (A, B) so the bar never changes height. -->
                    <Grid x:Name="ReadoutRows" RowSpacing="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                        </Grid.RowDefinitions>
                    </Grid>
                    <Button x:Name="ClearSampleButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed"
                            Click="OnClearSample" ToolTipService.ToolTip="Clear pixel sample (Esc)">
                        <FontIcon Glyph="&#xE894;" FontSize="16" />
                    </Button>
                </Grid>
            </Border>
            </Grid>
            </Border>
            </Grid>

            <Border x:Name="SidePane" Grid.Column="1" Width="372" Visibility="Collapsed" BorderThickness="1,0,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="PaneTabs" Orientation="Horizontal" Spacing="4" Margin="8,6">
                        <ToggleButton Content="Layers" Tag="layers" IsChecked="True" Style="{StaticResource TabToggleStyle}" Click="OnPaneTab" />
                        <ToggleButton Content="Pixel" Tag="pixel" Style="{StaticResource TabToggleStyle}" Click="OnPaneTab"
                                      ToolTipService.ToolTip="Pixel Analyzer" />
                        <ToggleButton Content="Info" Tag="info" Style="{StaticResource TabToggleStyle}" Click="OnPaneTab" />
                        <ToggleButton Content="Scopes" Tag="scopes" Style="{StaticResource TabToggleStyle}" Click="OnPaneTab" />
                    </StackPanel>

                    <!-- Layers -->
                    <ScrollViewer x:Name="LayersPage" Grid.Row="1" Padding="12,4,12,12">
                        <StackPanel Spacing="12">
                            <controls:LayerPanel x:Name="LayerPanelA" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="LockAovSwitch" Content="Lock AOV (A and B switch together)" IsChecked="True"
                                          Click="OnLockAovToggled" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="OnSwap" VerticalAlignment="Center" ToolTipService.ToolTip="Swap A and B">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                                        <TextBlock Text="Swap" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <controls:LayerPanel x:Name="LayerPanelB" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pixel Analyzer -->
                    <ScrollViewer x:Name="PixelPage" Grid.Row="1" Padding="12,4,12,12" Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="Pixel Analyzer" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Click="OnClearSample" ToolTipService.ToolTip="Clear pixel sample (Esc)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE894;" FontSize="14" />
                                        <TextBlock Text="Clear sample" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap"
                                       Text="Hover reads the pixel under the pointer. Ctrl+drag draws a red box that stays sampled after you let go; Ctrl+click pins a single pixel. Values are scene-linear and unclamped (above 1.0 shows as is). The swatch is the displayed colour. Press Esc or Clear sample to remove the box." />
                            <TextBlock x:Name="AnalyzerEmpty" Text="Load a sequence to sample it." Opacity="0.7" />
                            <StackPanel x:Name="AnalyzerHost" Spacing="16" />
                            <TextBlock x:Name="ProbeDetail" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Info -->
                    <ScrollViewer x:Name="InfoPage" Grid.Row="1" Padding="12,4,12,12" Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="Frame statistics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button HorizontalAlignment="Right" Content="Refresh" Click="OnRefreshStats" />
                            </Grid>
                            <TextBlock x:Name="StatsDetail" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="Note for this frame" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                     PlaceholderText="Review note (exported with File > Export notes)" TextChanged="OnNoteChanged" />
                            <TextBlock Text="Metadata" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButtons x:Name="MetaSlotButtons" MaxColumns="2" SelectedIndex="0" SelectionChanged="OnMetaSlotChanged">
                                    <x:String>A</x:String>
                                    <x:String>B</x:String>
                                </RadioButtons>
                                <AutoSuggestBox x:Name="MetaFilter" Grid.Column="1" PlaceholderText="Filter" QueryIcon="Find"
                                                TextChanged="OnMetaFilterChanged" VerticalAlignment="Center" />
                            </Grid>
                            <ListView x:Name="MetadataList" SelectionMode="None" MaxHeight="520" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Scopes -->
                    <ScrollViewer x:Name="ScopesPage" Grid.Row="1" Padding="12,4,12,12" Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <RadioButtons x:Name="ScopeSlotButtons" MaxColumns="2" SelectedIndex="0" SelectionChanged="OnScopeSlotChanged"
                                          Header="Layer">
                                <x:String>A</x:String>
                                <x:String>B</x:String>
                            </RadioButtons>
                            <TextBlock Text="Histogram (display referred)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border Height="150" CornerRadius="4" Background="Black">
                                <Canvas x:Name="HistogramCanvas" SizeChanged="OnScopeSizeChanged" />
                            </Border>
                            <TextBlock Text="Waveform (RGB)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border Height="170" CornerRadius="4" Background="Black">
                                <Image x:Name="WaveformImage" Stretch="Fill" />
                            </Border>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                                       Text="Scopes show the layer's current frame after exposure and the OCIO view, like the viewer." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Timeline with per-layer cache bars -->
        <Grid Grid.Row="4" Padding="12,2" ColumnSpacing="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3" />
                <RowDefinition Height="1" />
                <RowDefinition Height="3" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="RangeStartText" Text="-" VerticalAlignment="Center" />
            <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="1" IsEnabled="False"
                    ValueChanged="OnTimelineChanged" />
            <Canvas x:Name="CacheStripA" Grid.Column="1" Grid.Row="1" Margin="10,0" />
            <Canvas x:Name="CacheStripB" Grid.Column="1" Grid.Row="3" Margin="10,0" />
            <TextBlock x:Name="RangeEndText" Grid.Column="2" Text="-" VerticalAlignment="Center" />
            <TextBlock x:Name="CurrentFrameText" Grid.Column="3" MinWidth="64" Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Transport -->
        <Grid Grid.Row="5" Padding="8,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="HudToggle" Style="{StaticResource IconToggleStyle}" IsChecked="True" Click="OnHudToggle" ToolTipService.ToolTip="Image info (HUD)">
                    <FontIcon Glyph="&#xE946;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="OverlaysToggle" Style="{StaticResource IconToggleStyle}" IsChecked="True" Click="OnOverlaysToggle" ToolTipService.ToolTip="Overlays (Q)">
                    <FontIcon Glyph="&#xE890;" FontSize="16" />
                </ToggleButton>
                <Button Click="OnFit" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Fit (F)">
                    <FontIcon Glyph="&#xE9A6;" FontSize="16" />
                </Button>
                <Button Click="OnFullScreen" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Full screen (F11)">
                    <FontIcon Glyph="&#xE740;" FontSize="16" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Click="OnStepBackward" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Step backward (Left)">
                        <FontIcon Glyph="&#xE76B;" FontSize="16" />
                    </Button>
                    <Button Click="OnStepForward" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Step forward (Right)">
                        <FontIcon Glyph="&#xE76C;" FontSize="16" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Click="OnPlayReverse" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Play backward (Ctrl+Space)">
                        <FontIcon x:Name="ReverseIcon" Glyph="&#xE768;" FontSize="16" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                    <Button Click="OnPlayPause" Style="{StaticResource IconAccentButtonStyle}" ToolTipService.ToolTip="Play / pause (Space)">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Click="OnGoToStart" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Go to start (Home)">
                        <FontIcon Glyph="&#xE892;" FontSize="16" />
                    </Button>
                    <Button Click="OnGoToEnd" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Go to end (End)">
                        <FontIcon Glyph="&#xE893;" FontSize="16" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBlock x:Name="CacheText" VerticalAlignment="Center" Opacity="0.7" />
                <TextBlock x:Name="MeasuredFpsText" VerticalAlignment="Center" MinWidth="70" />
                <ComboBox x:Name="FpsCombo" Width="110" SelectionChanged="OnFpsChanged" ToolTipService.ToolTip="Playback frame rate" />
                <ToggleButton x:Name="LoopToggle" Style="{StaticResource IconToggleStyle}" IsChecked="True" Click="OnLoopToggle" ToolTipService.ToolTip="Loop on / off">
                    <FontIcon Glyph="&#xE8EE;" FontSize="16" />
                </ToggleButton>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
